# --- Фронтенд (VITE_*) ---

# Базовый URL API. По умолчанию — относительный `/api` на том же домене;
# менять нужно, только если API вынесен на отдельный домен.
# VITE_API_URL=https://api.mabl.ru

# --- Серверные переменные (во фронтенд не попадают) ---
#
# В продакшене они живут в /etc/mabl-lms.env и читаются systemd при старте
# сервиса (шаблон — deploy/mabl-lms.env.example, инструкция — DEPLOY.md).
# Локально можно положить их в .env и запускать сервер так:
#   node --env-file=.env dist-server/server/index.js

# Порт и интерфейс приложения. Наружу его публикует nginx.
# PORT=3000
# HOST=127.0.0.1

# Строка подключения к PostgreSQL. Обязательна: без неё сайт не работает.
# Managed Service for PostgreSQL: порт 6432 и sslmode=verify-full.
# DATABASE_URL=postgresql://mabl:пароль@rc1a-xxxx.mdb.yandexcloud.net:6432/mabl?sslmode=verify-full

# Корневой сертификат Яндекса для проверки TLS-соединения с БД.
# Скачивается на сервер: https://storage.yandexcloud.net/cloud-certs/CA.pem
# DATABASE_CA_FILE=/etc/ssl/certs/yandex-root.crt

# Секрет подписи токенов сессии. В проде задайте собственное значение
# (openssl rand -hex 32). При смене секрета все сессии становятся недействительными.
# AUTH_SECRET=длинная-случайная-строка

# ЮKassa — боевая оплата. Без этих ключей эндпоинты оплаты отвечают 503.
# Берутся из личного кабинета ЮKassa (Магазин → Интеграция).
# YOOKASSA_SHOP_ID=123456
# YOOKASSA_SECRET_KEY=live_secret_key
# (опц.) базовый URL для возврата после оплаты, если автоопределение не подходит.
# YOOKASSA_RETURN_URL=https://mabl.ru

# Стартовый аккаунт администратора: создаётся при инициализации базы, если
# такого e-mail в ней ещё нет. Пароля по умолчанию нет — если ADMIN_PASSWORD
# не задан, инициализация сгенерирует случайный и покажет его один раз.
# ADMIN_EMAIL=admin@mabl.ru
# ADMIN_PASSWORD=длинный-случайный-пароль

# Публичный Telegram-канал академии, из которого автоматически подтягиваются
# новости с картинками. Укажите @username (можно без «@» или полной ссылкой).
# TELEGRAM_CHANNEL=mabl_academy

# Хранилище файлов SCORM-пакетов и файлов материалов — Yandex Object Storage
# (S3-совместимое). Бакет держится приватным: файлы наружу отдаёт приложение
# по /scorm-store/* и /files/*. Ключи выдаёт сервисный аккаунт с ролью
# storage.editor (Консоль YC → Сервисные аккаунты → Создать статический ключ).
# S3_BUCKET=mabl-lms-files
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_REGION=ru-central1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Потолок размера одного загружаемого файла в МБ. Должен совпадать с
# client_max_body_size в конфиге nginx.
# MAX_UPLOAD_MB=256

# Секрет для одноразовой инициализации БД через POST /api/setup?secret=...
# SETUP_SECRET=change-me

# --- Фронтенд (VITE_*) ---

# Базовый URL API. По умолчанию — относительный `/api` на том же домене;
# менять нужно, только если API вынесен на отдельный домен.
# VITE_API_URL=https://api.mabl.ru

# --- Серверные переменные (Vercel / Neon), во фронтенд не попадают ---

# Строка подключения к базе Neon (обычно проставляется интеграцией Vercel ↔ Neon).
# Обязательна: без неё сайт не работает.
# DATABASE_URL=postgres://...

# Секрет подписи токенов сессии. В проде задайте собственное значение.
# AUTH_SECRET=длинная-случайная-строка

# ЮKassa — боевая оплата. Без этих ключей эндпоинты оплаты отвечают 503.
# Берутся из личного кабинета ЮKassa (Магазин → Интеграция).
# YOOKASSA_SHOP_ID=123456
# YOOKASSA_SECRET_KEY=live_secret_key
# (опц.) базовый URL для возврата после оплаты, если автоопределение не подходит.
# YOOKASSA_RETURN_URL=https://mabl.ru

# Стартовый аккаунт администратора: создаётся при инициализации базы, если
# такого e-mail в ней ещё нет. Пароля по умолчанию нет — если ADMIN_PASSWORD
# не задан, инициализация сгенерирует случайный и покажет его один раз.
# ADMIN_EMAIL=admin@mabl.ru
# ADMIN_PASSWORD=длинный-случайный-пароль

# Публичный Telegram-канал академии, из которого автоматически подтягиваются
# новости с картинками. Укажите @username (можно без «@» или полной ссылкой).
# TELEGRAM_CHANNEL=mabl_academy

# Хранилище файлов SCORM-пакетов и файлов материалов (Vercel Blob). Нужно для
# загрузки и раздачи этих файлов. Подключается в панели Vercel:
# Storage → Create → Blob → Connect. Vercel сам проставит переменные
# (в зависимости от модели хранилища):
#   • классическая:   BLOB_READ_WRITE_TOKEN
#   • OIDC/presigned: BLOB_STORE_ID + BLOB_WEBHOOK_PUBLIC_KEY (+ VERCEL_OIDC_TOKEN
#     подставляет рантайм). Код поддерживает обе модели.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# BLOB_STORE_ID=store_...
# BLOB_WEBHOOK_PUBLIC_KEY=...

# Секрет для одноразовой инициализации БД через POST /api/setup?secret=...
# SETUP_SECRET=change-me

# Окружение сервиса МАБЛ LMS на VM Yandex Cloud.
#
# Установка:
#   sudo cp deploy/mabl-lms.env.example /etc/mabl-lms.env
#   sudo chown root:root /etc/mabl-lms.env && sudo chmod 600 /etc/mabl-lms.env
#   sudo nano /etc/mabl-lms.env      # подставить реальные значения
#   sudo systemctl restart mabl-lms
#
# Формат — KEY=VALUE без кавычек и без `export` (это EnvironmentFile systemd).

# ---------- сервер ----------
PORT=3000
HOST=127.0.0.1
NODE_ENV=production
# Потолок размера одного загружаемого файла (МБ). Должен совпадать с
# client_max_body_size в конфиге nginx.
MAX_UPLOAD_MB=256

# ---------- база данных (Managed Service for PostgreSQL) ----------
# Хост берётся в консоли YC: кластер → Хосты → FQDN. Порт всегда 6432.
DATABASE_URL=postgresql://mabl:ПАРОЛЬ@rc1a-xxxxxxxx.mdb.yandexcloud.net:6432/mabl?sslmode=verify-full
# Корневой сертификат Яндекса (скачивается на VM, см. DEPLOY.md).
DATABASE_CA_FILE=/etc/ssl/certs/yandex-root.crt
# Размер пула соединений (по умолчанию 10).
# DATABASE_POOL_MAX=10

# ---------- файловое хранилище (Object Storage) ----------
S3_BUCKET=mabl-lms-files
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
# Статический ключ доступа сервисного аккаунта с ролью storage.editor.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- аутентификация ----------
# Секрет подписи токенов сессии. Сгенерировать: openssl rand -hex 32
# ВАЖНО: перенесите значение из Vercel, иначе все активные сессии слетят.
AUTH_SECRET=

# ---------- стартовый администратор ----------
# Учитывается только при инициализации БД, если такого e-mail ещё нет.
ADMIN_EMAIL=admin@mabl.ru
ADMIN_PASSWORD=

# ---------- одноразовая инициализация БД ----------
# POST /api/setup?secret=... — создаёт таблицы и аккаунт администратора.
SETUP_SECRET=

# ---------- ЮKassa ----------
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Базовый URL для возврата после оплаты (если автоопределение не подходит).
YOOKASSA_RETURN_URL=https://mabl.ru

# ---------- Telegram ----------
# Публичный канал академии, из которого подтягиваются новости.
TELEGRAM_CHANNEL=mabl_academy

# Ключ для вызова синхронизации новостей по GET. Таймер systemd шлёт его в
# заголовке Authorization; без ключа маршрут открыт всем и защищён только
# ограничением частоты.
CRON_SECRET=

# ---------- собственный домен ----------
# Канонический адрес сайта: подставляется в ссылки писем и return_url оплаты,
# а также разрешает CORS для собственного фронтенда.
SITE_URL=https://mabl.ru
# Дополнительные доверенные домены через запятую (например, www и тестовый).
ALLOWED_HOSTS=www.mabl.ru

# ---------- почта ----------
# Транспорт выбирается по заданным переменным: SMTP имеет приоритет над Resend.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true
# Либо API-ключ Resend вместо SMTP.
RESEND_API_KEY=
# Адрес отправителя: Академия МАБЛ <noreply@mabl.ru>
MAIL_FROM=
